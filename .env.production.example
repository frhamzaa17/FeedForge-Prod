# Copy to .env.production on the server. Never commit the real file.
NODE_ENV=production

# IP-only / no-domain deployment. Use the EC2 console's Public IPv4 address.
# This is deliberately HTTP; public IPs cannot receive a trusted TLS certificate.
PUBLIC_IP=203.0.113.10
APP_URL=http://203.0.113.10
API_URL=http://203.0.113.10
NEXT_PUBLIC_API_URL=/api
CORS_ORIGINS=http://203.0.113.10
PORT=4000
# Required for HTTP only. Do not use this with a real domain/HTTPS deployment.
COOKIE_SECURE=false

# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace_with_a_unique_64_character_hex_value

# Configure at least one provider; the API refuses to start in production without one.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional server-managed social OAuth credentials. You can also enter them per user in Settings.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
